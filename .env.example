# BrowserPilot Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ─── Database ───────────────────────────────────────────────
# SQLite database file path (Prisma)
DATABASE_URL="file:./dev.db"

# ─── AI Provider ─────────────────────────────────────────────
# Anthropic Claude API key
# Leave empty to run in Demo Mode (no real AI required)
ANTHROPIC_API_KEY=

# AI model to use
AI_MODEL=claude-sonnet-4-6

# ─── Application ─────────────────────────────────────────────
# Application base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application environment
NODE_ENV=development

# ─── Browser Automation ──────────────────────────────────────
# Maximum task duration in milliseconds (default: 5 minutes)
BROWSER_TASK_TIMEOUT_MS=300000

# Screenshot storage directory (relative to project root)
SCREENSHOT_DIR=public/screenshots

# Maximum concurrent browser sessions
MAX_CONCURRENT_SESSIONS=1

# ─── Demo Mode ───────────────────────────────────────────────
# Set to "true" to force Demo Mode even if ANTHROPIC_API_KEY is present
FORCE_DEMO_MODE=false
